From: mirx developers
Subject: [PATCH] winex11: Serialise opening and closing input methods between threads.

Every thread opens its own display and, in x11drv_init_thread_data,
its own input method with XOpenIM; ThreadDetach closes it with
XCloseIM.  Displays are independent, but libX11's XIM implementation
(modules/im/ximcp) keeps process-wide state in globals it does not
lock even after XInitThreads: the list of open input methods
(_XimCurrentIMlist, grown with realloc in _XimSetIMStructureList), the
cached default compose tree and its refcount (imLcIm.c), and the list of
instantiate callbacks (imInsClbk.c).

So threads that create their first window at the same time race in
XOpenIM and corrupt the heap: glibc aborts with "double free or
corruption (fasttop)" or "realloc(): invalid old size" from
realloc <- _XimOpenIM <- xim_create <- xim_thread_attach <-
x11drv_init_thread_data <- X11DRV_WindowPosChanging <-
NtUserCreateWindowEx.

Open and close input methods, and (un)register the instantiate
callback, under one mutex.  libX11 also walks the instantiate
callbacks while it filters events, which this cannot serialise; that
only matters when an input method server appears or goes away.

Seen with 16 threads that each create one window of the same classes at
once: 4 of 100 runs aborted without this patch.

---
--- a/dlls/winex11.drv/xim.c
+++ b/dlls/winex11.drv/xim.c
@@ -50,6 +50,12 @@
 static XIMStyle input_style = 0;
 static XIMStyle input_style_req = XIMPreeditCallbacks | XIMStatusCallbacks;
 
+/* Each thread has its own display, but libX11 keeps the state of its input
+ * methods (the list of open ones, the shared compose tree, the instantiate
+ * callbacks) in process globals without locking them: open and close input
+ * methods, and register their callbacks, under this mutex only. */
+static pthread_mutex_t xim_mutex = PTHREAD_MUTEX_INITIALIZER;
+
 static const char *debugstr_xim_style( XIMStyle style )
 {
     char buffer[1024], *buf = buffer;
@@ -377,8 +383,11 @@
     INT i;
     XIM xim;
 
-    if (!(xim = XOpenIM( data->display, NULL, NULL, NULL )))
+    pthread_mutex_lock( &xim_mutex );
+    xim = XOpenIM( data->display, NULL, NULL, NULL );
+    if (!xim)
     {
+        pthread_mutex_unlock( &xim_mutex );
         WARN("Could not open input method.\n");
         return NULL;
     }
@@ -394,6 +403,7 @@
     {
         WARN( "Could not find supported input style.\n" );
         XCloseIM( xim );
+        pthread_mutex_unlock( &xim_mutex );
         return NULL;
     }
 
@@ -411,16 +421,26 @@
 
     if (!input_style) input_style = input_style_fallback;
     TRACE( "selected style %#lx %s\n", input_style, debugstr_xim_style( input_style ) );
+    pthread_mutex_unlock( &xim_mutex );
 
     return xim;
 }
 
+static void register_xim_open( Display *display, XPointer user )
+{
+    pthread_mutex_lock( &xim_mutex );
+    XRegisterIMInstantiateCallback( display, NULL, NULL, NULL, xim_open, user );
+    pthread_mutex_unlock( &xim_mutex );
+}
+
 static void xim_open( Display *display, XPointer user, XPointer arg )
 {
     struct x11drv_thread_data *data = (void *)user;
     TRACE( "display %p, data %p, arg %p\n", display, user, arg );
     if (!(data->xim = xim_create( data ))) return;
+    pthread_mutex_lock( &xim_mutex );
     XUnregisterIMInstantiateCallback( display, NULL, NULL, NULL, xim_open, user );
+    pthread_mutex_unlock( &xim_mutex );
 }
 
 static void xim_destroy( XIM xim, XPointer user, XPointer arg )
@@ -429,7 +449,7 @@
     TRACE( "xim %p, user %p, arg %p\n", xim, user, arg );
     if (data->xim != xim) return;
     data->xim = NULL;
-    XRegisterIMInstantiateCallback( data->display, NULL, NULL, NULL, xim_open, user );
+    register_xim_open( data->display, user );
 }
 
 void xim_thread_attach( struct x11drv_thread_data *data )
@@ -444,7 +464,15 @@
     if (list) XFreeStringList( list );
 
     if ((data->xim = xim_create( data ))) return;
-    XRegisterIMInstantiateCallback( display, NULL, NULL, NULL, xim_open, (XPointer)data );
+    register_xim_open( display, (XPointer)data );
+}
+
+void xim_thread_detach( struct x11drv_thread_data *data )
+{
+    if (!data->xim) return;
+    pthread_mutex_lock( &xim_mutex );
+    XCloseIM( data->xim );
+    pthread_mutex_unlock( &xim_mutex );
 }
 
 static BOOL xic_destroy( XIC xic, XPointer user, XPointer arg )
--- a/dlls/winex11.drv/x11drv_main.c
+++ b/dlls/winex11.drv/x11drv_main.c
@@ -692,7 +692,7 @@
 
     if (data)
     {
-        if (data->xim) XCloseIM( data->xim );
+        xim_thread_detach( data );
         if (data->font_set) XFreeFontSet( data->display, data->font_set );
         if (data->net_supported) XFree( data->net_supported );
         XSync( gdi_display, False ); /* make sure XReparentWindow requests have completed before closing the thread display */
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -910,6 +910,7 @@
 /* XIM support */
 extern BOOL xim_init( const WCHAR *input_style );
 extern void xim_thread_attach( struct x11drv_thread_data *data );
+extern void xim_thread_detach( struct x11drv_thread_data *data );
 extern BOOL xim_in_compose_mode(void);
 extern void xim_set_result_string( HWND hwnd, const char *str, UINT count );
 extern XIC X11DRV_get_ic( HWND hwnd );
